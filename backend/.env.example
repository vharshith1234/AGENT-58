# Local development (recommended — avoids Neon sleep / P1001):
DATABASE_URL="postgresql://agent58:agent58_local_dev@127.0.0.1:5432/agent58?schema=public"

# Or Neon (can sleep on free tier and cause Can't reach database server):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"

PRISMA_CLIENT_ENGINE_TYPE="binary"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Comma-separated extra browser origins allowed by CORS (optional; *.vercel.app is already allowed)
# CORS_ORIGINS=https://your-custom-domain.com

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Brevo (Sendinblue) — forgot-password OTP emails
# Prefer API key; SMTP is used as fallback. Never commit real keys.
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SMTP_KEY="xsmtpsib-your-brevo-smtp-key"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="9e6263001@smtp-brevo.com"
# Must match an ACTIVE verified sender in Brevo → Senders
BREVO_FROM_EMAIL="medichain123@gmail.com"
BREVO_FROM_NAME="Agent 58"
OTP_EXPIRES_MINUTES="10"
# If Brevo SMTP is not activated yet, OTP is shown in UI / logged (local only)
OTP_DEV_FALLBACK="1"

# Gmail SMTP fallback (recommended until Brevo transactional is activated)
# 1) Enable 2-Step Verification on the Gmail account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-char password below (spaces OK)
GMAIL_USER="vemulaharshith1476@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

