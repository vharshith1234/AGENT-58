# Local development (recommended — avoids Neon sleep / P1001):
DATABASE_URL="postgresql://agent58:agent58_local_dev@127.0.0.1:5432/agent58?schema=public"

# Or Neon (can sleep on free tier and cause Can't reach database server):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"

PRISMA_CLIENT_ENGINE_TYPE="binary"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Comma-separated extra browser origins allowed by CORS (optional; *.vercel.app is already allowed)
# CORS_ORIGINS=https://your-custom-domain.com

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
